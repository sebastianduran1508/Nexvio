# ==========================================================================
# Plantilla de variables de entorno del backend — Nexvio
# Copia este archivo a ".env" y rellena los valores reales.
# El .env NUNCA se sube al repo (está en .gitignore); este .example SÍ.
# ==========================================================================

# Conexión a la base de datos (Supabase / PostgreSQL)
# La app se conecta como nexvio_app (rol SIN bypass de RLS).
# Las migraciones (DIRECT_URL) usan postgres (admin).
DATABASE_URL="postgresql://nexvio_app.<ref>:<PASSWORD>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres"

# Supabase Auth
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon/publishable key>"

# Puerto del backend en local
PORT=3000
