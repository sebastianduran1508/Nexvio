// ==========================================================================
// Esquema de Prisma — Nexvio
// FASE 1 · Bloque 2 — Núcleo del ERD (4 tablas). El resto se agrega luego.
//
// Convenciones:
//  - PK uuid en todas las tablas.
//  - Nombres de tabla y columna en snake_case (@@map / campos snake_case)
//    para que coincidan 1:1 con las políticas RLS en SQL.
//  - TODA tabla de negocio lleva organizacion_id (la columna sobre la que
//    después construimos el Row Level Security).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // En Prisma 7 las URLs ya NO van aquí:
  //  - Migraciones -> prisma.config.ts (usa DIRECT_URL)
  //  - Runtime      -> driver adapter en PrismaService (usa DATABASE_URL)
}

// Roles del sistema (coincide con el RolesGuard del backend)
enum Rol {
  admin
  organizador
  coordinador
  participante
}

// Raíz del tenant: cada organización es un cliente aislado de los demás.
model Organizacion {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  slug      String   @unique
  estado    String   @default("activa")
  creado_en DateTime @default(now())

  // --- Datos legales (8.7.c): el RESPONSABLE del tratamiento (Ley 1581). ---
  // El Decreto 1377 (art. 13) exige que la política diga quién es y cómo
  // contactarlo. Los editan el organizador y el superadmin; se insertan en el
  // texto de la política que ve el asistente.
  legal_razon_social String?
  legal_nit          String?
  legal_direccion    String?
  legal_ciudad       String? // domicilio
  legal_correo       String? // canal para consultas y reclamos
  legal_telefono     String?
  legal_area         String? // persona o área que atiende ("Atención al asociado")
  legal_url_politica String? // su política completa, si la tiene publicada

  // Relaciones inversas
  consentimientos      ConsentimientoDatos[]
  solicitudes_datos    SolicitudDatos[]
  sesiones_favoritas   SesionFavorita[]
  sesion_sponsors      SesionSponsor[]
  usuarios             Usuario[]
  congresos            Congreso[]
  sesiones             Sesion[]
  ponentes             Ponente[]
  sesion_ponentes      SesionPonente[]
  inscripciones        Inscripcion[]
  preguntas            Pregunta[]
  encuestas            Encuesta[]
  opciones_encuesta    OpcionEncuesta[]
  respuestas_encuesta  RespuestaEncuesta[]
  intereses_networking InteresNetworking[]
  conexiones           Conexion[]
  mensajes_chat        MensajeChat[]
  sponsors             Sponsor[]
  personalizaciones    PersonalizacionCongreso[]
  dispositivos_push    DispositivoPush[]
  notificaciones       Notificacion[]

  @@map("organizacion")
}

model Usuario {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String?  @db.Uuid // NULL solo para el Admin global
  email           String   @unique // correo real o SINTETICO (lo exige Supabase Auth)
  username        String?  @unique // lo que el asistente escribe al entrar: "JPGarcia"
  nombre          String
  apellidos       String?
  rol             Rol
  creado_en       DateTime @default(now())

  // --- Perfil de asistente (Bloque 8.1) -----------------------------------
  // Vienen del Excel que la organizacion envia y el admin importa (8.3).
  tipo_documento        String? // CC | CE | PA | TI | NIT
  numero_documento      String?
  telefono              String?
  cargo                 String?
  empresa               String?
  pais                  String? // nombre visible: "Colombia"
  pais_codigo           String? // ISO-3166 alpha-2 para la bandera: "CO"
  foto_url              String?
  descripcion           String? // 8.7.c: "sobre mí" (máx. 500), se ve en networking
  anio_nacimiento       Int? // 8.7.c: solo el AÑO (minimización): para mostrar la edad
  visible_networking    Boolean   @default(true) // 8.7.d: interruptor "Aparecer en networking"
  // 8.7.d: contacto que SOLO ven sus conexiones (match), y solo si lo activa.
  compartir_contacto    Boolean   @default(false)
  // ...y dato por dato (consentimiento granular): si el principal está
  // encendido, se comparte cada uno que también lo esté.
  compartir_telefono    Boolean   @default(true)
  compartir_correo      Boolean   @default(true)
  compartir_linkedin    Boolean   @default(true)
  contacto_email        String? // su correo real (el de login puede ser sintético)
  linkedin_url          String?
  debe_cambiar_password Boolean   @default(false) // contrasena temporal -> cambio al 1er ingreso
  acepto_datos_en       DateTime? // Ley 1581: cuando acepto el tratamiento de datos
  politica_datos_version String? // 8.7: QUÉ versión de la política aceptó (prueba de la autorización)
  suprimido_en          DateTime? // 8.7.c: sus datos se suprimieron (fila anonimizada)

  organizacion           Organizacion?       @relation(fields: [organizacion_id], references: [id])
  inscripciones          Inscripcion[]
  preguntas              Pregunta[]
  respuestas_encuesta    RespuestaEncuesta[]
  intereses_emitidos     InteresNetworking[] @relation("intereses_emitidos")
  intereses_recibidos    InteresNetworking[] @relation("intereses_recibidos")
  mensajes_chat          MensajeChat[]       @relation("mensajes_chat")
  dispositivos_push      DispositivoPush[]
  notificaciones_creadas Notificacion[]      @relation("notificaciones_creadas")
  consentimientos        ConsentimientoDatos[]
  solicitudes_datos      SolicitudDatos[]    @relation("solicitudes_titular")
  solicitudes_atendidas  SolicitudDatos[]    @relation("solicitudes_atendidas")
  fichas_ponente         Ponente[]           @relation("ponente_cuenta")
  sesiones_favoritas     SesionFavorita[]

  // Evita importar dos veces a la misma persona en la misma organizacion.
  // Ojo: en Postgres los NULL no chocan entre si, asi que el staff (sin
  // documento) no se ve afectado.
  @@unique([organizacion_id, numero_documento])
  @@index([organizacion_id])
  @@map("usuario")
}

model Congreso {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  nombre          String
  fecha_inicio    DateTime @db.Date
  fecha_fin       DateTime @db.Date
  estado          String   @default("borrador")

  // --- Datos del evento (Bloque 8.1) --------------------------------------
  descripcion  String?
  ciudad       String?
  pais         String? // nombre visible: "Colombia"
  pais_codigo  String? // ISO-3166 alpha-2: "CO" (para la bandera)
  lugar        String? // sede / hotel / auditorio
  // Zona horaria del evento. Las sesiones se guardan en UTC; esta columna dice
  // en que horario hay que PINTARLAS (resuelve el pendiente arrastrado).
  zona_horaria String  @default("America/Bogota")

  organizacion         Organizacion             @relation(fields: [organizacion_id], references: [id])
  sesiones             Sesion[]
  ponentes             Ponente[]
  inscripciones        Inscripcion[]
  intereses_networking InteresNetworking[]
  sponsors             Sponsor[]
  personalizacion      PersonalizacionCongreso?
  notificaciones       Notificacion[]

  @@index([organizacion_id])
  @@map("congreso")
}

model Sesion {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  congreso_id     String   @db.Uuid
  titulo          String
  inicio          DateTime
  fin             DateTime
  sala            String?

  // --- Agenda por dia (Bloque 8.1) ----------------------------------------
  // "break" = cafe/almuerzo/receso: ocupa un hueco en la agenda pero no tiene
  // ponente ni preguntas. El resto son charlas.
  tipo        String  @default("charla") // charla | break | taller | plenaria
  descripcion String?
  orden       Int? // desempate cuando dos cosas empiezan a la misma hora

  organizacion   Organizacion    @relation(fields: [organizacion_id], references: [id])
  congreso       Congreso        @relation(fields: [congreso_id], references: [id])
  ponentes       SesionPonente[]
  preguntas      Pregunta[]
  encuestas      Encuesta[]
  notificaciones Notificacion[]
  favoritas      SesionFavorita[] // 8.7.e: quiénes la tienen en "Mi agenda"

  // 8.7.f: "Patrocinada por…" — uno, dos o los que quieran (tabla intermedia).
  sponsors SesionSponsor[]

  @@index([organizacion_id])
  @@index([congreso_id])
  @@map("sesion")
}

// ---------------------------------------------------------------------------
// FASE 3 — Módulo Congresos: Ponentes
// ---------------------------------------------------------------------------

// Un ponente pertenece a un congreso (ERD: CONGRESO ||--o{ PONENTE "registra").
// Lleva organizacion_id como toda tabla de negocio (para el RLS).
model Ponente {
  id              String  @id @default(uuid()) @db.Uuid
  organizacion_id String  @db.Uuid
  congreso_id     String  @db.Uuid
  nombre          String
  bio             String?
  foto_url        String?

  // --- Ficha de speaker (Bloque 8.1) --------------------------------------
  cargo       String?
  empresa     String?
  pais        String?
  pais_codigo String? // ISO-3166 alpha-2 -> la bandera la pinta el front
  orden       Int? // para ordenar la vitrina de speakers en la app

  // 8.7.d: la CUENTA de la app de este speaker (opcional). Vinculado, aparece
  // en el networking con la insignia PONENTE y se puede conectar con él.
  usuario_id String? @db.Uuid

  organizacion Organizacion    @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso        @relation(fields: [congreso_id], references: [id])
  usuario      Usuario?        @relation("ponente_cuenta", fields: [usuario_id], references: [id], onDelete: SetNull)
  sesiones     SesionPonente[]

  @@unique([congreso_id, usuario_id]) // una cuenta = una ficha por congreso
  @@index([organizacion_id])
  @@index([congreso_id])
  @@map("ponente")
}

// Tabla intermedia de la relación muchos-a-muchos Sesion <-> Ponente
// (ERD: SESION }o--o{ PONENTE "expone"). La hacemos EXPLÍCITA (en vez de la
// M:N implícita de Prisma) por dos razones:
//   1) para poder ponerle organizacion_id y así aplicarle RLS como al resto;
//   2) para controlar el nombre real de la tabla (sesion_ponente) y sus índices.
// La pareja (sesion_id, ponente_id) es única: un ponente no se repite en una sesión.
model SesionPonente {
  id              String @id @default(uuid()) @db.Uuid
  organizacion_id String @db.Uuid
  sesion_id       String @db.Uuid
  ponente_id      String @db.Uuid

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  sesion       Sesion       @relation(fields: [sesion_id], references: [id])
  ponente      Ponente      @relation(fields: [ponente_id], references: [id])

  @@unique([sesion_id, ponente_id])
  @@index([organizacion_id])
  @@map("sesion_ponente")
}

// ---------------------------------------------------------------------------
// FASE 4 — Modulo Inscripciones
// ---------------------------------------------------------------------------

// La inscripcion enlaza a un USUARIO (rol participante) con un CONGRESO dentro
// de un tenant (ERD: USUARIO ||--o{ INSCRIPCION, CONGRESO ||--o{ INSCRIPCION).
// Lleva organizacion_id como toda tabla de negocio (para el RLS).
// La pareja (congreso_id, usuario_id) es unica: nadie se inscribe dos veces al
// mismo congreso.
model Inscripcion {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  congreso_id     String   @db.Uuid
  usuario_id      String   @db.Uuid
  estado          String   @default("confirmada") // confirmada | cancelada
  registrado_en   DateTime @default(now())

  // --- Datos del Excel de la organizacion (Bloque 8.1) --------------------
  // El tipo de suscripcion es POR CONGRESO (la misma persona puede ser
  // "Miembro" en uno y "General" en otro), por eso vive aqui y no en usuario.
  tipo_suscripcion String?
  origen           String  @default("manual") // manual | excel

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso     @relation(fields: [congreso_id], references: [id])
  usuario      Usuario      @relation(fields: [usuario_id], references: [id])

  @@unique([congreso_id, usuario_id])
  @@index([organizacion_id])
  @@index([congreso_id])
  @@index([usuario_id])
  @@map("inscripcion")
}

// ---------------------------------------------------------------------------
// FASE 5 — Participacion en vivo (preguntas y encuestas)
// ---------------------------------------------------------------------------

// Pregunta que un asistente formula en una sesion (ERD: SESION ||--o{ PREGUNTA,
// USUARIO ||--o{ PREGUNTA). El coordinador la modera (estado).
model Pregunta {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  sesion_id       String   @db.Uuid
  usuario_id      String   @db.Uuid
  texto           String
  estado          String   @default("pendiente") // pendiente|aprobada|rechazada|respondida
  creado_en       DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  sesion       Sesion       @relation(fields: [sesion_id], references: [id])
  usuario      Usuario      @relation(fields: [usuario_id], references: [id])

  @@index([organizacion_id])
  @@index([sesion_id])
  @@map("pregunta")
}

// Encuesta lanzada en una sesion (ERD: SESION ||--o{ ENCUESTA). Tiene opciones y
// se activa/cierra (activa) para votar en vivo.
model Encuesta {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  sesion_id       String   @db.Uuid
  pregunta        String
  activa          Boolean  @default(false)
  creado_en       DateTime @default(now())

  organizacion Organizacion        @relation(fields: [organizacion_id], references: [id])
  sesion       Sesion              @relation(fields: [sesion_id], references: [id])
  opciones     OpcionEncuesta[]
  respuestas   RespuestaEncuesta[]

  @@index([organizacion_id])
  @@index([sesion_id])
  @@map("encuesta")
}

// Una opcion de respuesta de una encuesta (ERD: ENCUESTA ||--o{ OPCION_ENCUESTA).
model OpcionEncuesta {
  id              String @id @default(uuid()) @db.Uuid
  organizacion_id String @db.Uuid
  encuesta_id     String @db.Uuid
  texto           String

  organizacion Organizacion        @relation(fields: [organizacion_id], references: [id])
  encuesta     Encuesta            @relation(fields: [encuesta_id], references: [id])
  respuestas   RespuestaEncuesta[]

  @@index([organizacion_id])
  @@index([encuesta_id])
  @@map("opcion_encuesta")
}

// El voto de un usuario a una opcion (ERD: OPCION_ENCUESTA ||--o{ RESPUESTA_ENCUESTA,
// USUARIO ||--o{ RESPUESTA_ENCUESTA). Mejora sobre el ERD: guardamos tambien
// encuesta_id para garantizar UN voto por encuesta por persona (@@unique).
model RespuestaEncuesta {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  encuesta_id     String   @db.Uuid
  opcion_id       String   @db.Uuid
  usuario_id      String   @db.Uuid
  creado_en       DateTime @default(now())

  organizacion Organizacion   @relation(fields: [organizacion_id], references: [id])
  encuesta     Encuesta       @relation(fields: [encuesta_id], references: [id])
  opcion       OpcionEncuesta @relation(fields: [opcion_id], references: [id])
  usuario      Usuario        @relation(fields: [usuario_id], references: [id])

  @@unique([encuesta_id, usuario_id])
  @@index([organizacion_id])
  @@index([opcion_id])
  @@map("respuesta_encuesta")
}

// ---------------------------------------------------------------------------
// FASE 6 — Networking (interes mutuo -> match -> chat limitado)
// ---------------------------------------------------------------------------

// Interes de un asistente (emisor) en otro (receptor) dentro de un congreso.
// Es DIRECCIONAL: A->B es una fila distinta de B->A. Cuando existen las dos,
// hay "match" (ambas pasan a 'correspondido' y se crea una Conexion).
model InteresNetworking {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  congreso_id     String   @db.Uuid
  emisor_id       String   @db.Uuid
  receptor_id     String   @db.Uuid
  estado          String   @default("pendiente") // pendiente|correspondido|rechazado|descartado (8.7.d: "Ahora no")
  creado_en       DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso     @relation(fields: [congreso_id], references: [id])
  emisor       Usuario      @relation("intereses_emitidos", fields: [emisor_id], references: [id])
  receptor     Usuario      @relation("intereses_recibidos", fields: [receptor_id], references: [id])
  conexion     Conexion?

  @@unique([congreso_id, emisor_id, receptor_id]) // un interes por direccion y congreso
  @@index([organizacion_id])
  @@index([congreso_id])
  @@map("interes_networking")
}

// Conexion: nace cuando hay match. Apunta al interes que completo el match y
// lleva el limite de mensajes del chat (regla de negocio: networking acotado).
model Conexion {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  interes_id      String   @unique @db.Uuid
  limite_mensajes Int      @default(20)
  creado_en       DateTime @default(now())

  organizacion Organizacion      @relation(fields: [organizacion_id], references: [id])
  interes      InteresNetworking @relation(fields: [interes_id], references: [id])
  mensajes     MensajeChat[]

  @@index([organizacion_id])
  @@map("conexion")
}

// Un mensaje del chat de una conexion (ERD: CONEXION ||--o{ MENSAJE_CHAT).
model MensajeChat {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  conexion_id     String   @db.Uuid
  autor_id        String   @db.Uuid
  texto           String
  enviado_en      DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  conexion     Conexion     @relation(fields: [conexion_id], references: [id])
  autor        Usuario      @relation("mensajes_chat", fields: [autor_id], references: [id])

  @@index([organizacion_id])
  @@index([conexion_id])
  @@map("mensaje_chat")
}

// ---------------------------------------------------------------------------
// FASE 8 · Bloque 8.1 — Tablas nuevas del panel del administrador
// (sponsors, personalizacion por congreso, push y notificaciones)
// ---------------------------------------------------------------------------

// Patrocinador de un congreso. El admin sube el logo a Supabase Storage y aqui
// guardamos la URL publica. La app los muestra ordenados por nivel y orden.
model Sponsor {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  congreso_id     String   @db.Uuid
  nombre          String
  logo_url        String?
  sitio_web       String?
  nivel           String   @default("general") // oro | plata | bronce | general
  orden           Int      @default(0)
  creado_en       DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso     @relation(fields: [congreso_id], references: [id])
  sesiones     SesionSponsor[] // 8.7.f: las charlas que patrocina

  @@index([organizacion_id])
  @@index([congreso_id])
  @@map("sponsor")
}

// Marca del congreso (logo, colores, portada) que la app movil lee para
// "vestirse" con los colores del evento. Es 1:1 con congreso: el @unique de
// congreso_id es lo que convierte la relacion en uno-a-uno.
model PersonalizacionCongreso {
  id                 String   @id @default(uuid()) @db.Uuid
  organizacion_id    String   @db.Uuid
  congreso_id        String   @unique @db.Uuid
  logo_url           String?
  imagen_portada_url String?
  color_primario     String? // hex: "#5A46F0"
  color_secundario   String? // hex: "#FF7A59"
  tema_default       String   @default("sistema") // claro | oscuro | sistema
  actualizado_en     DateTime @updatedAt

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso     @relation(fields: [congreso_id], references: [id])

  @@index([organizacion_id])
  @@map("personalizacion_congreso")
}

// Un telefono concreto donde entregar las push. Expo le da a cada instalacion
// un "expo push token"; sin esta tabla no sabriamos a que aparatos enviar.
// Una persona puede tener varios (telefono + tablet).
model DispositivoPush {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  usuario_id      String   @db.Uuid
  expo_push_token String
  plataforma      String? // android | ios
  activo          Boolean  @default(true)
  creado_en       DateTime @default(now())
  visto_en        DateTime @updatedAt // ultimo registro del token (para limpiar viejos)

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      Usuario      @relation(fields: [usuario_id], references: [id])

  @@unique([usuario_id, expo_push_token]) // el mismo token no se duplica por persona
  @@index([organizacion_id])
  @@index([expo_push_token])
  @@map("dispositivo_push")
}

// Un mensaje push que el admin escribe y envia a los asistentes de su congreso.
// Guardamos el historial (que se envio, cuando y con que resultado) para que el
// admin lo vea en el panel y para poder reintentar.
model Notificacion {
  id              String    @id @default(uuid()) @db.Uuid
  organizacion_id String    @db.Uuid
  congreso_id     String    @db.Uuid
  titulo          String
  cuerpo          String
  destino         String    @default("todos") // todos | sesion | favoritos (8.7.e: solo quienes marcaron la charla)
  sesion_id       String?   @db.Uuid // solo si destino = sesion
  // borrador | programada | enviando | enviada | fallida (8.6)
  estado          String    @default("borrador")
  enviados        Int       @default(0)
  fallidos        Int       @default(0)
  creado_por_id   String?   @db.Uuid
  creado_en       DateTime  @default(now())
  enviado_en      DateTime?
  // Bloque 8.6: si tiene fecha, se envía sola a esa hora (estado "programada").
  programada_para DateTime?

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  congreso     Congreso     @relation(fields: [congreso_id], references: [id])
  sesion       Sesion?      @relation(fields: [sesion_id], references: [id])
  creado_por   Usuario?     @relation("notificaciones_creadas", fields: [creado_por_id], references: [id])

  @@index([organizacion_id])
  @@index([congreso_id])
  @@index([estado, programada_para]) // el programador busca "programadas ya vencidas"
  @@map("notificacion")
}

// ---------------------------------------------------------------------------
// FASE 8 · Bloque 8.6 — Ayuda del panel
// ---------------------------------------------------------------------------

// Artículos de ayuda: la guía de uso del panel para organizadores no técnicos.
//
// ⚠️ ES LA ÚNICA TABLA SIN organizacion_id, a propósito: la ayuda es de TODA la
// plataforma, no de un cliente. Su RLS es distinto (ver la migración
// fase8_ayuda): todos pueden LEER, y solo se puede ESCRIBIR si la base sabe
// que quien escribe es el superadmin (app.rol = 'admin').
model ArticuloAyuda {
  id             String   @id @default(uuid()) @db.Uuid
  titulo         String
  contenido      String // en Markdown: # títulos, - listas, **negrita**
  orden          Int      @default(0)
  publicado      Boolean  @default(true) // false = borrador, solo lo ve el superadmin
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("articulo_ayuda")
}

// ---------------------------------------------------------------------------
// FASE 8 · Bloque 8.7.c — Ley 1581: historial de autorizaciones y solicitudes
// ---------------------------------------------------------------------------

// Cada vez que alguien ACEPTA o REVOCA la política queda una fila. Es la prueba
// completa ("aceptó el 30-oct, revocó el 5-nov, volvió a aceptar el 6-nov"), no
// solo el último valor que guarda usuario.acepto_datos_en.
// usuario_id queda NULL si sus datos se suprimen: el historial se conserva
// anónimo (la organización puede necesitar demostrar que atendió todo bien).
model ConsentimientoDatos {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  usuario_id      String?  @db.Uuid
  accion          String // acepta | revoca
  version         String? // versión de la política (en "acepta")
  creado_en       DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      Usuario?     @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([organizacion_id])
  @@index([usuario_id])
  @@map("consentimiento_datos")
}

// Solicitudes del titular sobre sus datos (hoy: supresión). Las atiende el
// organizador desde el panel; el plazo legal de un reclamo es de 15 días
// hábiles (art. 15, Ley 1581). Se guarda el nombre "foto" del titular porque,
// si se suprime, su fila de usuario queda anónima.
model SolicitudDatos {
  id              String    @id @default(uuid()) @db.Uuid
  organizacion_id String    @db.Uuid
  usuario_id      String?   @db.Uuid
  titular_nombre  String // copia al crearla
  tipo            String    @default("supresion") // supresion (a futuro: rectificacion, consulta)
  motivo          String?
  estado          String    @default("pendiente") // pendiente | atendida | rechazada
  respuesta       String? // lo que el organizador le contesta (obligatorio al rechazar)
  creado_en       DateTime  @default(now())
  atendida_en     DateTime?
  atendida_por_id String?   @db.Uuid

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      Usuario?     @relation("solicitudes_titular", fields: [usuario_id], references: [id], onDelete: SetNull)
  atendida_por Usuario?     @relation("solicitudes_atendidas", fields: [atendida_por_id], references: [id], onDelete: SetNull)

  @@index([organizacion_id])
  @@index([usuario_id])
  @@index([organizacion_id, estado])
  @@map("solicitud_datos")
}

// ---------------------------------------------------------------------------
// FASE 8 · Bloque 8.7.e — Mi agenda
// ---------------------------------------------------------------------------

// Una charla que la persona marcó con ⭐ ("Mi agenda"). Sirve para su agenda
// personal, para que el organizador vea cuántos la marcaron y para enviar un
// aviso SOLO a esos interesados.
model SesionFavorita {
  id              String   @id @default(uuid()) @db.Uuid
  organizacion_id String   @db.Uuid
  usuario_id      String   @db.Uuid
  sesion_id       String   @db.Uuid
  creado_en       DateTime @default(now())

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      Usuario      @relation(fields: [usuario_id], references: [id])
  sesion       Sesion       @relation(fields: [sesion_id], references: [id])

  @@unique([usuario_id, sesion_id]) // marcarla dos veces no la duplica
  @@index([organizacion_id])
  @@index([sesion_id])
  @@map("sesion_favorita")
}

// ---------------------------------------------------------------------------
// FASE 8 · Bloque 8.7.f — Patrocinio de charlas (varios por charla)
// ---------------------------------------------------------------------------

// Una pareja charla–sponsor. `orden` dice cuál se muestra primero (el orden en
// que el organizador los eligió). Mismo patrón que SesionPonente.
// Si se borra la charla o el sponsor, la pareja se borra sola (Cascade).
model SesionSponsor {
  organizacion_id String @db.Uuid
  sesion_id       String @db.Uuid
  sponsor_id      String @db.Uuid
  orden           Int    @default(0)

  organizacion Organizacion @relation(fields: [organizacion_id], references: [id])
  sesion       Sesion       @relation(fields: [sesion_id], references: [id], onDelete: Cascade)
  sponsor      Sponsor      @relation(fields: [sponsor_id], references: [id], onDelete: Cascade)

  @@id([sesion_id, sponsor_id]) // un sponsor no se repite en la misma charla
  @@index([organizacion_id])
  @@index([sponsor_id])
  @@map("sesion_sponsor")
}
