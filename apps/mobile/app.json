{
  "expo": {
    "name": "Nexvio",
    "slug": "nexvio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexvio.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#4A35D6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nexvio.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#4A35D6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#4A35D6"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nexvio usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": "Nexvio usa la cámara para que tomes tu foto de perfil."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5A46F0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f402303-0d36-4361-b2db-f1d99e460448"
      }
    },
    "owner": "duran1508"
  }
}
